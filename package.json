{
  "name": "C7NTAX",
  "version": "1.0.0",
  "private": true,
  "description": "C7NTAX — Professional Services Automation platform replicating AutoTask PSA",
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "handlebars@<4.7.10": "^4.7.10",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "semver@<5.7.2": "^5.7.2",
      "qs@<6.16.0": "^6.16.0",
      "dompurify@<3.4.16": "^3.4.16",
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "js-yaml@<4.3.2": "^4.3.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "tar@<7.5.21": "^7.5.21",
      "app-builder-lib@<26.15.0": "^26.17.0",
      "builder-util-runtime@<9.7.0": "^9.7.0",
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:sample-off": "pnpm --filter @C7NTAX/api db:sample-off",
    "db:sample-on": "pnpm --filter @C7NTAX/api db:sample-on",
    "clean": "turbo run clean && rimraf node_modules",
    "guard:routes": "node scripts/check-route-guards.mjs",
  "guard:api-docs": "node scripts/check-api-docs.mjs",
    "guard:config": "tsx scripts/check-config-reads.mts",
    "guard:console": "tsx scripts/check-console-catalog.mts",
    "guard:plugin": "tsx scripts/plugin-metadata.mts check",
    "plugin:bump": "tsx scripts/plugin-metadata.mts bump",
    "installer:build": "pwsh -NoProfile -File installer/outlook-addin/build.ps1",
    "guard:deps": "node scripts/audit-baseline.mjs",
  "probes:sweep": "pnpm --filter @C7NTAX/api probes:sweep",
  "probes:sweep:apply": "pnpm --filter @C7NTAX/api probes:sweep:apply",
    "deploy:preflight": "node scripts/azure/preflight.mjs",
    "deploy:preflight:full": "node scripts/azure/preflight.mjs --docker",
    "deploy:validate": "node scripts/azure/validate-bicep.mjs",
  "deploy:workflow": "node scripts/azure/check-workflow-shell.mjs",
    "deploy:dev": "pwsh -NoProfile -File scripts/azure/deploy-env.ps1 -Environment dev",
    "deploy:prod": "pwsh -NoProfile -File scripts/azure/deploy-env.ps1 -Environment prod",
    "guard:encoding": "node scripts/check-encoding.mjs"
  },
  "devDependencies": {
    "@types/speakeasy": "^2.0.10",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
